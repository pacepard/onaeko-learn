{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "types": ["vite/client"],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "useDefineForClassFields": true,
        "declaration": false,
        "declarationMap": false,
        "erasableSyntaxOnly": false,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "src/main.tsx",
        "src/App.tsx",
        "src/vite-env.d.ts",
        "src/agent/**/*.ts",
        "src/api/**/*.ts",
        "src/api/**/*.tsx",
        "src/app/**/*.tsx",
        "src/components/base/common/**/*.tsx",
        "src/components/base/onboarding/**/*.ts",
        "src/components/base/onboarding/**/*.tsx",
        "src/components/layouts/learn-layout.tsx",
        "src/components/layouts/onboarding-layout.tsx",
        "src/context/**/*.ts",
        "src/context/**/*.tsx",
        "src/dtos/**/*.ts",
        "src/dtos/**/*.tsx",
        "src/routes/**/*.ts",
        "src/routes/**/*.tsx",
        "src/services/storage.ts",
        "src/services/cookie.service.tsx",
        "src/styles/**/*.css",
        "src/utils/enums.util.ts",
        "src/utils/helpers.util.ts",
        "src/utils/interfaces.util.ts",
        "src/utils/logger.utl.ts",
        "src/utils/onboarding.ts",
        "src/utils/accounts.ts",
        "src/utils/scholarship-map.ts",
        "src/utils/youtube.ts",
        "src/utils/types.util.ts",
        "src/_data/**/*.ts",
        "src/_data/**/*.json"
    ]
}
